{
  "name": "flarum-community-node",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "check": "node --check worker/index.js && node --check server.mjs",
    "docker:build": "docker build -t flarum-community:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "deploy": "docker compose up -d --build --remove-orphans"
  }
}
