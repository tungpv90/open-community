# Supabase development runtime (public client credentials only)
SUPABASE_URL=https://gabzrqvagwnauudhahak.supabase.co
SUPABASE_ANON_KEY=your-development-anon-key

# Public URL registered in Supabase Authentication > URL Configuration.
PUBLIC_SITE_URL=http://localhost:3000
# Enable matching providers in Supabase Authentication > Providers.
AUTH_OAUTH_PROVIDERS=google,facebook,linkedin
# Public Cloudflare Turnstile site key for the signup challenge (empty disables it).
# Put the matching secret in Supabase Authentication > Attack Protection > Captcha, not here.
TURNSTILE_SITE_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN, or
# SUPABASE_DB_PASSWORD here. Use a secret manager or the Supabase CLI.
# Local Node.js port
PORT=3000
# Docker host port
FORUM_PORT=3000
# Optional published image name
FORUM_IMAGE=flarum-community:latest
